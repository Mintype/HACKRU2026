# Copy to .env and fill in.  NEVER commit the real .env.

# --- Gemini (Google AI Studio) -------------------------------------------
# Gemini WRITES the roasts. It does not speak them - see the ElevenLabs block.
# Without a key the app falls back to the hand-written roasts.
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models on the day of the event:
# model names move fast and older ones get retired for new accounts (the old
# google-generativeai package is deprecated). The app walks a fallback chain, so
# this picks the one to try first.
GEMINI_TEXT_MODEL=gemini-3.8-flash

# --- ElevenLabs (the voice) ---------------------------------------------
# The preferred engine: the free tier is ~10k characters/month, which suits
# short punchy roasts far better than a per-day request cap. "auto" voice mode
# uses ElevenLabs when this key is set, and the local engine otherwise.
ELEVENLABS_API_KEY=
# Premade voices work on a free plan; "library" voices (e.g. Rachel) need a paid
# subscription and answer HTTP 402. If a voice is not allowed, the app lists
# your account's voices and uses one of those instead.
# Default: Sarah. Voice list: elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Nest audio -----------------------------------------------------------
# Bluetooth MAC from `bluetoothctl devices` (primary route).
NEST_BLUETOOTH_MAC=
# Friendly name the Nest advertises to Chromecast (Wi-Fi cast backup).
NEST_CAST_NAME=
# Optional override for the Bluetooth playback command, e.g. paplay / pw-play.
POSTURE_BLUETOOTH_PLAYER=
# Optional voice for the offline fallback, e.g. "Microsoft Zira Desktop".
# POSTURE_LOCAL_VOICE=

# --- Runtime --------------------------------------------------------------
# POSTURE_DATA_DIR=/home/pi/posture-coach/data
# POSTURE_HOST=0.0.0.0
# POSTURE_PORT=5000
