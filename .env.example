# Copy to .env and fill in.  NEVER commit the real .env.

# --- Gemini (Google AI Studio) -------------------------------------------
# Without a key the app still works: it falls back to hand-written roasts and
# a local text-to-speech engine.
GEMINI_API_KEY=

# Check https://ai.google.dev/gemini-api/docs/models on the day of the event:
# model names move fast (the old google-generativeai package is deprecated).
GEMINI_TEXT_MODEL=gemini-2.5-flash
# TTS model names move fast and the free tier's ~10 requests/day is counted per
# model, so the app walks a fallback chain (see voice/gemini_tts.py). Setting
# this picks the one to try first.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# --- ElevenLabs (preferred voice) ---------------------------------------
# Free tier is ~10k characters/month, which suits short punchy roasts far
# better than Gemini's ~10 requests/day. With a key set, "auto" voice mode
# picks ElevenLabs first. Voice IDs are listed at elevenlabs.io/voice-library
# Free plans cannot use "library" voices via the API (HTTP 402); premade voices
# such as Sarah below work. If the configured voice is not allowed, the app
# lists your account's voices and uses one of those instead.
# Voice IDs are listed at elevenlabs.io/voice-library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Nest audio -----------------------------------------------------------
# Bluetooth MAC from `bluetoothctl devices` (primary route).
NEST_BLUETOOTH_MAC=
# Friendly name the Nest advertises to Chromecast (Wi-Fi cast backup).
NEST_CAST_NAME=
# Optional override for the Bluetooth playback command, e.g. paplay / pw-play.
POSTURE_BLUETOOTH_PLAYER=

# --- Runtime --------------------------------------------------------------
# POSTURE_DATA_DIR=/home/pi/posture-coach/data
# POSTURE_HOST=0.0.0.0
# POSTURE_PORT=5000
