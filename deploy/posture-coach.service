[Unit]
Description=Posture Coach (vision + Flask website + roast audio)
After=network-online.target bluetooth.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/posture-coach
EnvironmentFile=-/home/pi/posture-coach/.env
Environment=PYTHONUNBUFFERED=1
# Give the USB webcam and Bluetooth stack a moment to come up after boot.
ExecStartPre=/bin/sleep 5
ExecStart=/home/pi/posture-coach/.venv/bin/python run.py --host 0.0.0.0 --port 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
